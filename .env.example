# =============================================================================
# ตัวแปรสภาพแวดล้อมสำหรับเชื่อมต่อ Supabase Cloud (ใส่ใน Vercel Environment Variables หรือไฟล์ .env)
# หมายเหตุ: หากรันบน Server ของลูกค้า หรือรันทดสอบบน Vercel แบบไม่ต้องเชื่อม Supabase ไม่จำเป็นต้องตั้งค่านี้
# =============================================================================

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
PORT=3000
